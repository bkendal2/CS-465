{{> header}}

<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Travel</h1>
        <ul id="sites">
          {{#each trips}}
            <li>
              <a href="/api/trips/{{code}}">
                <img src="/images/{{image}}" alt="{{name}}">
              </a>
              <h2>{{name}}</h2>
              <p>{{description}}</p>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</div>

{{> footer}}