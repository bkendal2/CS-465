{{> header}}

<h1>{{title}}</h1>

<div class="row">
  {{#each trips}}
    <div class="col-md-4">
      <div class="card mb-4">
        <img src="/images/{{image}}" alt="{{name}}">
        <div class="card-body">
          <h5>{{name}}</h5>
          <p>{{destination}}</p>
          <p>{{description}}</p>
        </div>
      </div>
    </div>
  {{/each}}
</div>

{{> footer}}